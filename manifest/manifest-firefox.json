{
  "manifest_version": 3,
  "name": "디시콘 선택기",
  "description": "디시콘에 로켓을 달아주세요.",
  "version": "2.0.1",
  "icons": {
    "16": "icons/icon_dccon_16.png",
    "32": "icons/icon_dccon_32.png",
    "48": "icons/icon_dccon_48.png",
    "128": "icons/icon_dccon_128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "main.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.chzzk.naver.com/*","*://*.ci.me/*"],
      "js": ["common/dccon.js", "dcconSelector.js"],
      "css": ["css/dccon.css"]
    }
  ],
  "browser_specific_settings": {
  "gecko": {
    "id": "qarty11@gmail.com",
    "strict_min_version": "58.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
		    "images/*",
        "css/*",
        "icons/*",
        "lib/*",
        "common/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}